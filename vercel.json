{
  "version": 2,
  "installCommand": "npm --prefix bokku install",
  "buildCommand": "npm --prefix bokku run build",
  "outputDirectory": "bokku/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
